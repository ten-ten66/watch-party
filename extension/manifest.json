{
  "manifest_version": 3,
  "name": "My Watch Party",
  "version": "0.1.0",
  "description": "Netflix / プライムビデオの再生位置を友達と同期する自作ウォッチパーティー拡張",
  "permissions": ["storage", "tabs"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.netflix.com/*",
        "https://www.amazon.co.jp/*",
        "https://www.primevideo.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["injected/netflix.js"],
      "matches": ["https://www.netflix.com/*"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "My Watch Party"
  }
}
