{
  "name": "my-watch-party",
  "version": "0.2.0",
  "private": true,
  "description": "Netflix / プライムビデオの再生位置を友達と同期するデスクトップアプリ",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "test": "node --test test/"
  },
  "dependencies": {
    "discord.js": "^14.15.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.0"
  },
  "build": {
    "appId": "com.example.mywatchparty",
    "productName": "MyWatchParty",
    "files": ["main.js", "sync.js", "transports.js", "cdp.js", "browser.js", "preload.js", "renderer/**"],
    "win": { "target": "nsis" },
    "mac": { "target": "dmg" },
    "linux": { "target": "AppImage" }
  }
}
